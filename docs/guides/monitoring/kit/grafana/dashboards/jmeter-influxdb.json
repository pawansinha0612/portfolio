{
  "title": "JMeter load test (InfluxDB)",
  "uid": "jmeter-load-test",
  "description": "JMeter Backend Listener (InfluxdbBackendListenerClient) results. From pawansinha.com.au/guides/monitoring/grafana-stack/",
  "tags": [
    "jmeter",
    "load-testing"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-jmeter"
        },
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"application\"",
        "definition": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"application\"",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "transaction",
        "label": "Transaction",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-jmeter"
        },
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"transaction\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" != 'internal' AND \"transaction\" != 'all'",
        "definition": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"transaction\"",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "JMeter: whole test",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Active threads",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "query": "SELECT last(\"meanAT\") FROM \"jmeter\" WHERE \"transaction\" = 'internal' AND \"application\" =~ /^$application$/ AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "threads",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Throughput (last 1m)",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "query": "SELECT sum(\"count\") / 60 FROM \"jmeter\" WHERE \"transaction\" = 'all' AND \"application\" =~ /^$application$/ AND time > now() - 1m",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "req/s",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Error rate (whole range)",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "query": "SELECT sum(\"countError\") / sum(\"count\") FROM \"jmeter\" WHERE \"transaction\" = 'all' AND \"application\" =~ /^$application$/ AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "errors",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Total requests",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
