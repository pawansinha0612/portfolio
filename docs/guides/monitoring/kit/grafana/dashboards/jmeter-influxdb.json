            "uid": "influxdb-jmeter"
          },
          "query": "SELECT sum(\"countError\") / 5 FROM \"jmeter\" WHERE \"transaction\" = 'all' AND \"application\" =~ /^$application$/ AND $timeFilter GROUP BY time(5s) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "errors/s",
          "refId": "A"
