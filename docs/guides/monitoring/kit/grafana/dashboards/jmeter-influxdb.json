        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "query": "SELECT sum(\"count\") FROM \"jmeter\" WHERE \"transaction\" = 'all' AND \"application\" =~ /^$application$/ AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "requests",
          "refId": "A"
